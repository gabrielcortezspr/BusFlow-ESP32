# Copie para ".env" e ajuste os valores. O .env real NÃO deve ser commitado.

# Conexão com o PostgreSQL usada pelo Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/busflow?schema=public"

# Porta HTTP da API
PORT=8888

# Broker MQTT (Mosquitto) que recebe os eventos dos ESP32
MQTT_HOST="localhost"
MQTT_PORT=1883
