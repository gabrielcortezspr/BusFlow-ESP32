{
  "name": "busflow",
  "version": "1.0.0",
  "author": "Ítalo Monte <italopessoal@outlook.com>",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "mqtt": "mosquitto -c mosquitto.conf -v"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.0",
    "prisma": "^6.8.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "mqtt": "^5.13.0"
  },
  "description": "API do BusFlow: recebe eventos MQTT dos ESP32 e expõe dados de ocupação via REST",
  "engines": {
    "node": ">=18"
  }
}
